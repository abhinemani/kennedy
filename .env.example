# Set these in the Railway dashboard under Variables.
# Never commit real values. Copy this file to .env.local for local development only.

# Set for you when you add a Postgres database in the Railway dashboard.
DATABASE_URL=

# The passphrase that opens the console. Change it from the example below.
OPERATOR_PASSPHRASE=change-me

# Long random strings. Any password generator will do.
SESSION_SECRET=
IP_HASH_SALT=

# Only needed once a send provider posts delivery reports back. Until then, leave it unset
# and the webhook refuses everything.
SEND_WEBHOOK_SECRET=
# Only when the send provider is Instantly. Made in Instantly under Settings, API keys.
INSTANTLY_API_KEY=

# Only the AI follow-up needs these. The survey works without them.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
